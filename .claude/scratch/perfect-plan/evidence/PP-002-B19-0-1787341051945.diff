+    let mut handle = RestrictedAuthorityHandle::open_with_before_open(
+        path,
+        PhysicalPathKind::RegularFile,
+        &identity,
+        before_open,
+    )
+    .map_err(|_| {
+        vec![RegistryIssue::Unreadable(
