+  font-family: var(--mono);
+}
+
+.ui-navigation-map-head {
+  display: flex;
+  align-items: flex-end;
+  justify-content: space-between;
+  gap: 24px;
+  max-width: 1360px;
+  margin: 0 auto;
+  padding: 14px 16px;
+  border: 1px solid #c5c2b9;
