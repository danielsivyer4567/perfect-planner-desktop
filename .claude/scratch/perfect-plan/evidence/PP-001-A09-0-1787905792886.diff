+.ui-map-page-body section { display: grid; gap: 4px; }
+.ui-map-page-body code { overflow-wrap: anywhere; color: #3f5946; font-size: 6px; }
+.ui-map-page-body p,
+.ui-map-page-body li { color: #6f7671; font-size: 6.2px; line-height: 1.45; }
+.ui-map-page-body ul { padding-left: 14px; }
+
+.ui-map-branch-empty {
+  margin-top: 30px;
