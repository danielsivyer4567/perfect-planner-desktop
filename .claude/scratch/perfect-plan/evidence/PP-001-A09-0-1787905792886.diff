+  background: rgba(248, 246, 240, .94);
+  box-shadow: var(--shadow);
+}
+
+.ui-navigation-map-head > div:first-child { display: grid; gap: 4px; }
+.ui-navigation-map-head > div:first-child > span { color: #50705a; font-size: 6.5px; font-weight: 900; letter-spacing: .95px; }
+.ui-navigation-map-head h2 { font-size: 20px; line-height: 1.1; letter-spacing: -.5px; }
+.ui-navigation-map-head p { color: #6b706a; font-size: 8px; }
+
+.ui-map-counts { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 6px; }
+.ui-map-counts span { padding: 5px 7px; border: 1px solid #c3c8c2; border-radius: 999px; color: #5d655f; background: #fff; font-size: 6.5px; }
+.ui-map-counts b { color: #355b40; font-size: 8px; }
+.ui-map-counts span[data-state="warning"] { border-color: #c09052; color: #8b5b22; }
+
+.ui-map-disclosure {
+  max-width: 1360px;
+  margin: 8px auto 20px;
+  padding: 8px 12px;
+  border-left: 3px solid #77917d;
+  color: #5d675f;
+  background: rgba(248, 246, 240, .82);
+  font-size: 7px;
+  line-height: 1.5;
+}
+
+.ui-map-canvas {
+  position: relative;
+  display: grid;
+  max-width: 1360px;
+  gap: 18px;
+  margin: 0 auto;
+  padding: 10px 0 30px;
+}
+
+.ui-map-axis {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: 50%;
+  width: 4px;
+  transform: translateX(-2px);
+  border-right: 1px solid #95a69a;
+  border-left: 1px solid #95a69a;
+  background: #d8dfd9;
+}
+
+.ui-map-spine-row {
+  position: relative;
+  z-index: 1;
+  display: grid;
+  grid-template-columns: minmax(240px, 1fr) 300px minmax(240px, 1fr);
+  align-items: start;
+  gap: 42px;
+}
+
+.ui-map-spine-segment {
+  position: relative;
+  display: grid;
+  min-height: 116px;
+  align-content: center;
+  gap: 6px;
+  padding: 18px 38px;
+  border: 1px solid #9eaaa0;
+  border-radius: 32px 8px 32px 8px;
+  background: #faf9f5;
+  box-shadow: 0 7px 22px rgba(52, 66, 55, .12), 0 0 0 5px rgba(233, 229, 220, .88);
+  text-align: center;
+}
+
+.ui-map-spine-segment::before {
+  position: absolute;
+  top: 50%;
+  left: 50%;
+  z-index: -1;
+  width: 18px;
+  height: 18px;
+  transform: translate(-50%, -50%);
+  border: 4px solid #e9e5dc;
+  border-radius: 50%;
+  content: "";
+  background: #4e8a5c;
+}
+
+.ui-map-spine-id { color: #3e704b; font-size: 8px; font-weight: 900; letter-spacing: 1px; }
