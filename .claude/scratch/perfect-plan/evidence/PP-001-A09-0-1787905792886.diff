+  top: 50%;
+  display: inline-flex;
+  min-width: 38px;
+  min-height: 32px;
+  align-items: center;
+  justify-content: center;
+  gap: 4px;
+  transform: translateY(-50%);
+  border: 1px solid #697c6e;
+  border-radius: 999px;
+  color: #eef4ef;
+  background: #2b4032;
+  font: 800 8px var(--mono);
+  cursor: pointer;
+}
+
+.ui-map-branch-toggle.left { left: -20px; }
+.ui-map-branch-toggle.right { right: -20px; }
+.ui-map-branch-toggle[aria-expanded="true"] { border-color: #91bd9a; background: #406b4c; box-shadow: 0 0 0 3px rgba(78, 138, 92, .16); }
+.ui-map-branch-toggle > span[aria-hidden="true"] { font-size: 15px; line-height: 1; }
+
+.ui-map-branch {
+  position: relative;
+  display: grid;
+  gap: 8px;
+  min-width: 0;
+}
+
+.ui-map-branch.open::after {
+  position: absolute;
+  top: 56px;
+  width: 42px;
+  border-top: 2px dashed #8aa08f;
+  content: "";
+}
+
+.ui-map-branch.left::after { right: -42px; }
+.ui-map-branch.right::after { left: -42px; }
+
+.ui-map-page {
