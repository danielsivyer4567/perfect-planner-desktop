+.ui-map-page-id { padding: 4px 6px; border-radius: 4px; color: #f2f6f3; background: #3b5e46; font-size: 7px; font-weight: 900; }
+.ui-map-page.support-work .ui-map-page-id { background: #735f43; }
+.ui-map-page-copy { display: grid; min-width: 0; gap: 3px; }
+.ui-map-page-copy strong { color: #263129; font-size: 8px; line-height: 1.35; }
