+                broker.publish_signal(&actor, &contradictory, 1_301),
+                Err(TicketError::Journal(_))
+            ));
+            assert_eq!(broker.journal.read_verified().unwrap().len(), 2);
+            let _ = std::fs::remove_dir_all(root);
+        }
+    }
