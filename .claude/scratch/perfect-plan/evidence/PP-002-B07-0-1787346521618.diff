+}
+
+impl ClearancePermit {
+    pub(crate) fn snapshot_hash(&self) -> &str {
+        &self.binding.snapshot_hash
+    }
+    pub(crate) fn participant_id(&self) -> &str {
+        &self.binding.participant_id
+    }
+    pub(crate) fn node_id(&self) -> &str {
+        &self.binding.node_id
+    }
