+    #[test]
+    fn digest_encoding_is_domain_and_length_separated() {
+        let digest = |domain: &'static [u8], fields: &[&str]| {
+            let mut encoder = DigestEncoder::new(domain);
+            for field in fields {
+                encoder.text(field);
+            }
+            encoder.finish()
+        };
+        assert_ne!(digest(b"domain-a", &["ab", "c"]), digest(b"domain-a", &["a", "bc"]));
+        assert_ne!(digest(b"domain-a", &["same"]), digest(b"domain-b", &["same"]));
+        assert_eq!(digest(b"domain-a", &["same"]), digest(b"domain-a", &["same"]));
+    }
