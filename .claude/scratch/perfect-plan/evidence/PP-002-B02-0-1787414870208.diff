+        let digest = |domain: &'static [u8], fields: &[&str]| {
+            let mut encoder = DigestEncoder::new(domain);
+            for field in fields {
+                encoder.text(field);
+            }
+            encoder.finish()
+        };
+        assert_ne!(
+            digest(b"domain-a", &["ab", "c"]),
+            digest(b"domain-a", &["a", "bc"])
