+    #[cfg(windows)]
+    fn create_directory_alias(link: &Path, target: &Path) {
+        let output = std::process::Command::new("cmd")
+            .args(["/D", "/S", "/C", "mklink", "/J"])
+            .arg(link)
+            .arg(target)
+            .output()
+            .expect("start mklink");
+        assert!(output.status.success(), "mklink /J failed");
+    }
+
+    #[cfg(unix)]
+    fn create_directory_alias(link: &Path, target: &Path) {
+        std::os::unix::fs::symlink(target, link).unwrap();
+    }
