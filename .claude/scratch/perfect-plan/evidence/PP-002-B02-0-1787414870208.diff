+        repository_identity: String::new(),
+        source_manifest_digest: source_manifest_digest.to_string(),
+        claims: Vec::new(),
+        contracts: Vec::new(),
+        digest: String::new(),
+    };
+    snapshot.digest = canonical_claim_snapshot_digest(&snapshot);
+    snapshot
+}
