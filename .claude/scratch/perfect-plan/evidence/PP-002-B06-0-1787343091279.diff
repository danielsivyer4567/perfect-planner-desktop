+    fn direct_claims(
+        count: usize,
+        kind: CanonicalClaimKind,
+        same_key: bool,
+        same_alias: bool,
+    ) -> (Vec<CanonicalClaim>, Vec<ActiveClaimContract>) {
+        let mut claims = Vec::with_capacity(count);
+        let mut contracts = Vec::with_capacity(count);
+        for index in 0..count {
+            let participant_id = opaque(&format!("direct-participant:{index}"));
+            let key_label = if same_key {
+                "direct-shared-key".to_string()
+            } else {
+                format!("direct-key:{index}")
+            };
+            let mut claim = CanonicalClaim {
+                claim_id: String::new(),
+                participant_id: participant_id.clone(),
+                kind,
+                canonical_key: opaque(&key_label),
+                ancestor_keys: Vec::new(),
+                physical_alias_key: if same_alias {
+                    Some(opaque("direct-shared-alias"))
+                } else {
+                    None
+                },
+            };
+            claim.claim_id = test_claim_id(&claim);
+            contracts.push(ActiveClaimContract {
+                participant_id,
+                run_identity: opaque(&format!("direct-run:{index}")),
+                worker_identity: opaque(&format!("direct-worker:{index}")),
+                fence: 1,
+                lease_generation: 1,
+                state: ActiveClaimState::Planned,
+                dependencies: Vec::new(),
+                assumption_digest: opaque(&format!("direct-assumption:{index}")),
+                policy_digest: opaque(&format!("direct-policy:{index}")),
+                active_state_digest: opaque(&format!("direct-state:{index}")),
+                disposition_rules: vec![ClaimDispositionRule {
+                    claim_id: claim.claim_id.clone(),
+                    disposition: ConflictDisposition::Wait,
+                }],
+                observed_at_ms: OBSERVED_MS,
+                expires_at_ms: EXPIRES_MS,
+            });
+            claims.push(claim);
+        }
+        (claims, contracts)
+    }
