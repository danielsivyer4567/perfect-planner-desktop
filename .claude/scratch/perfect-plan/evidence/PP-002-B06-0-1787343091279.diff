+    fn graph_index(contracts: &[ActiveClaimContract]) -> BTreeMap<&str, &ActiveClaimContract> {
+        contracts
+            .iter()
+            .map(|contract| (contract.participant_id.as_str(), contract))
+            .collect()
+    }
