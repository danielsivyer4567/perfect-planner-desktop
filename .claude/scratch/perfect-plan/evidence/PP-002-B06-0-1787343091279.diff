+    #[test]
+    fn dependency_graph_is_linear_bounded_and_cycle_exact() {
+        let chain_ids = (0..10_000)
+            .map(|index| format!("{index:064x}"))
+            .collect::<Vec<_>>();
+        let chain = chain_ids
+            .iter()
+            .enumerate()
+            .map(|(index, participant)| {
+                graph_contract(
+                    participant.clone(),
+                    (index > 0)
+                        .then(|| chain_ids[index - 1].clone())
+                        .into_iter()
+                        .collect(),
+                )
+            })
+            .collect::<Vec<_>>();
+        assert!(!dependency_graph_has_cycle(&graph_index(&chain), MAX_DEPENDENCY_EDGES).unwrap());
+
+        let root = "f".repeat(64);
+        let wide = std::iter::once(graph_contract(root.clone(), Vec::new()))
+            .chain(
+                (0..4_096).map(|index| graph_contract(format!("{index:064x}"), vec![root.clone()])),
+            )
+            .collect::<Vec<_>>();
+        let wide_index = graph_index(&wide);
+        assert!(!dependency_graph_has_cycle(&wide_index, MAX_DEPENDENCY_EDGES).unwrap());
+        assert_eq!(
+            dependency_graph_has_cycle(&wide_index, 4_095).unwrap_err(),
+            AnalysisUnknownReason::LimitExceeded
+        );
+
+        let cycle_ids = ["a".repeat(64), "b".repeat(64), "c".repeat(64)];
+        let cycle = vec![
+            graph_contract(cycle_ids[0].clone(), vec![cycle_ids[2].clone()]),
+            graph_contract(cycle_ids[1].clone(), vec![cycle_ids[0].clone()]),
+            graph_contract(cycle_ids[2].clone(), vec![cycle_ids[1].clone()]),
+        ];
+        assert!(dependency_graph_has_cycle(&graph_index(&cycle), MAX_DEPENDENCY_EDGES).unwrap());
+    }
