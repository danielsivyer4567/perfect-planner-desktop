+            .collect::<Vec<_>>();
+        let mut disposition_rules = claims_and_dispositions
+            .iter()
+            .map(|(claim, disposition)| ClaimDispositionRule {
+                claim_id: claim.claim_id.clone(),
+                disposition: *disposition,
+            })
+            .collect::<Vec<_>>();
+        disposition_rules.sort();
+        let contract = ActiveClaimContract {
+            participant_id,
+            run_identity: opaque(&format!("run:{name}")),
+            worker_identity: opaque(&format!("worker:{name}")),
+            fence: 1,
+            lease_generation: 1,
+            state: ActiveClaimState::Planned,
+            dependencies: Vec::new(),
+            assumption_digest: opaque(&format!("assumption:{name}")),
+            policy_digest: opaque(&format!("policy:{name}")),
+            active_state_digest: opaque(&format!("state:{name}")),
+            disposition_rules,
+            observed_at_ms: OBSERVED_MS,
+            expires_at_ms: EXPIRES_MS,
+        };
+        let mut snapshot = CanonicalClaimSnapshot {
+            schema_version: 1,
+            status: ClaimSnapshotStatus::Complete,
+            failure: None,
+            repository_identity: opaque("repository:shared"),
