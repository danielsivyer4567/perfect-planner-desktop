+//! Pure, bounded collision analysis over a registry-validated census.
+//!
+//! This module deliberately has no filesystem, network, process, clock, or renderer authority.
+//! The only entry point accepts `RegistryRead`: an UNKNOWN registry can never be converted into a
+//! graph, while a COMPLETE document is defensively rechecked using only its frozen metadata.
+
+use super::model::{
+    ActiveClaimContract, ActiveClaimState, CanonicalClaim, CanonicalClaimKind, ClaimSnapshotStatus,
+    CollisionVerdict, ConflictDisposition,
+};
+use super::registry::{
+    planner_manifest_digest, DiscoveryCensus, RegistryDocument, RegistryRead,
+    REGISTRY_SCHEMA_VERSION,
+};
+use sha2::{Digest, Sha256};
+use std::collections::{BTreeMap, BTreeSet};
+
+const ANALYZER_SCHEMA_VERSION: u32 = 1;
+const MAX_ANALYZER_ROOTS: usize = 128;
+const MAX_ANALYZER_PLANNERS: usize = 512;
+const MAX_ANALYZER_PARTICIPANTS: usize = 65_536;
+const MAX_ANALYZER_CLAIMS: usize = 131_072;
+const MAX_DEPENDENCY_EDGES: usize = 262_144;
+const MAX_ANCESTOR_PROBES: usize = 1_048_576;
+const MAX_PAIR_PROBES: usize = 1_048_576;
+const MAX_CONFLICTS: usize = 65_536;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub(crate) enum CollisionBasis {
+    ExactFile,
+    PhysicalAlias,
+    DirectoryPrefix,
+    Resource,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum AnalysisUnknownReason {
+    RegistryUnknown,
+    InvalidRegistry,
+    InvalidCensus,
+    StaleCensus,
+    IncompleteCoverage,
+    InvalidManifest,
+    InvalidClaimSnapshot,
+    InvalidActiveContract,
+    MissingDisposition,
+    ContradictoryDisposition,
+    MixedDispositions,
+    LimitExceeded,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct CollisionConflict {
+    pub(crate) conflict_id: String,
+    pub(crate) left_participant_id: String,
+    pub(crate) right_participant_id: String,
+    pub(crate) left_claim_id: String,
+    pub(crate) right_claim_id: String,
+    pub(crate) bases: Vec<CollisionBasis>,
+    /// A conflict is still a fact when its two signed rules are absent or contradictory.
+    /// Keeping the edge while withholding its disposition prevents UNKNOWN from hiding work.
+    pub(crate) disposition: Option<ConflictDisposition>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(crate) struct CollisionAnalysis {
+    pub(crate) schema_version: u32,
+    pub(crate) verdict: CollisionVerdict,
+    pub(crate) registry_generation: Option<u64>,
+    pub(crate) census_input_digest: Option<String>,
+    pub(crate) conflicts: Vec<CollisionConflict>,
+    pub(crate) unknown_reason: Option<AnalysisUnknownReason>,
+}
+
+impl CollisionAnalysis {
+    fn unknown(reason: AnalysisUnknownReason, generation: Option<u64>) -> Self {
+        Self::unknown_with_conflicts(reason, generation, None, Vec::new())
+    }
+
+    fn unknown_with_conflicts(
+        reason: AnalysisUnknownReason,
+        generation: Option<u64>,
+        census_input_digest: Option<String>,
+        conflicts: Vec<CollisionConflict>,
+    ) -> Self {
+        Self {
+            schema_version: ANALYZER_SCHEMA_VERSION,
+            verdict: CollisionVerdict::Unknown,
+            registry_generation: generation,
+            census_input_digest,
+            conflicts,
+            unknown_reason: Some(reason),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Copy)]
+struct ClaimRef<'a> {
+    claim: &'a CanonicalClaim,
+}
+
+type DispositionIndex<'a> = BTreeMap<(&'a str, &'a str), ConflictDisposition>;
+
+#[derive(Debug)]
+struct PendingConflict {
+    left: usize,
+    right: usize,
+    bases: BTreeSet<CollisionBasis>,
+}
+
+#[derive(Default)]
+struct WorkBudget {
+    ancestor_probes: usize,
+    pair_probes: usize,
+}
+
+impl WorkBudget {
+    fn ancestor_probe(&mut self) -> Result<(), AnalysisUnknownReason> {
+        self.ancestor_probes = self
+            .ancestor_probes
+            .checked_add(1)
+            .ok_or(AnalysisUnknownReason::LimitExceeded)?;
+        if self.ancestor_probes > MAX_ANCESTOR_PROBES {
+            return Err(AnalysisUnknownReason::LimitExceeded);
+        }
+        Ok(())
+    }
+
+    fn pair_probe(&mut self) -> Result<(), AnalysisUnknownReason> {
+        self.pair_probes = self
+            .pair_probes
+            .checked_add(1)
+            .ok_or(AnalysisUnknownReason::LimitExceeded)?;
+        if self.pair_probes > MAX_PAIR_PROBES {
+            return Err(AnalysisUnknownReason::LimitExceeded);
+        }
+        Ok(())
+    }
+}
+
+/// Analyze only a registry result that has already crossed the native registry validation gate.
+/// This function is intentionally crate-private and performs no I/O of any kind.
+pub(crate) fn analyze_registry_read(read: &RegistryRead, now_ms: u64) -> CollisionAnalysis {
+    match read {
+        RegistryRead::Unknown(unknown) => {
+            CollisionAnalysis::unknown(AnalysisUnknownReason::RegistryUnknown, unknown.generation)
+        }
+        RegistryRead::Complete(document) => match analyze_document(document, now_ms) {
+            Ok(analysis) => analysis,
+            Err(reason) => CollisionAnalysis::unknown(reason, Some(document.generation)),
+        },
+    }
+}
+
+fn analyze_document(
+    document: &RegistryDocument,
+    now_ms: u64,
+) -> Result<CollisionAnalysis, AnalysisUnknownReason> {
+    if now_ms == 0
+        || document.schema_version != REGISTRY_SCHEMA_VERSION
+        || document.generation == 0
+        || document.updated_at_ms == 0
+        || document.updated_at_ms > now_ms
+    {
+        return Err(AnalysisUnknownReason::InvalidRegistry);
+    }
+    let census = document
+        .census
+        .as_ref()
+        .ok_or(AnalysisUnknownReason::InvalidCensus)?;
+    validate_census_coverage(document, census, now_ms)?;
+
+    let (claims, dispositions) = collect_claims(census, now_ms)?;
+    let pending = intersect_claims(&claims)?;
+    let (conflicts, authorization_failure) = authorize_conflicts(&claims, &dispositions, pending);
+    let verdict = match authorization_failure {
+        Some(reason) => {
+            return Ok(CollisionAnalysis::unknown_with_conflicts(
+                reason,
+                Some(document.generation),
+                Some(census.input_digest.clone()),
+                conflicts,
+            ))
+        }
+        None => match aggregate_verdict(&conflicts) {
+            Ok(verdict) => verdict,
+            Err(reason) => {
+                return Ok(CollisionAnalysis::unknown_with_conflicts(
+                    reason,
+                    Some(document.generation),
+                    Some(census.input_digest.clone()),
+                    conflicts,
+                ))
+            }
+        },
+    };
+
+    Ok(CollisionAnalysis {
+        schema_version: ANALYZER_SCHEMA_VERSION,
+        verdict,
+        registry_generation: Some(document.generation),
+        census_input_digest: Some(census.input_digest.clone()),
+        conflicts,
+        unknown_reason: None,
+    })
+}
+
+fn validate_census_coverage(
+    document: &RegistryDocument,
+    census: &DiscoveryCensus,
+    now_ms: u64,
+) -> Result<(), AnalysisUnknownReason> {
+    if census.registry_generation != document.generation
+        || census.captured_at_ms == 0
+        || census.captured_at_ms > now_ms
+        || census.expires_at_ms <= now_ms
+        || census.expires_at_ms <= census.captured_at_ms
+        || !is_sha256(&census.input_digest)
+    {
+        return Err(AnalysisUnknownReason::StaleCensus);
+    }
+    if document.configured_roots.is_empty()
+        || document.configured_roots.len() > MAX_ANALYZER_ROOTS
+        || document.registrations.is_empty()
+        || document.registrations.len() > MAX_ANALYZER_PLANNERS
+        || census.roots.len() != document.configured_roots.len()
+        || census.planners.len() != document.registrations.len()
+    {
+        return Err(AnalysisUnknownReason::IncompleteCoverage);
+    }
+
+    let configured_root_ids = sorted_unique(
+        document
+            .configured_roots
+            .iter()
+            .map(|root| root.root_id.as_str()),
+    )?;
+    let census_root_ids = sorted_unique(census.roots.iter().map(|root| root.root_id.as_str()))?;
+    if configured_root_ids != census_root_ids {
+        return Err(AnalysisUnknownReason::IncompleteCoverage);
+    }
+
+    let registration_ids = sorted_unique(
+        document
+            .registrations
+            .iter()
+            .map(|registration| registration.identity.planner_id.as_str()),
+    )?;
+    let planner_ids = sorted_unique(
+        census
+            .planners
+            .iter()
+            .map(|planner| planner.planner_id.as_str()),
+    )?;
+    if registration_ids != planner_ids {
+        return Err(AnalysisUnknownReason::IncompleteCoverage);
+    }
+
+    let mut rooted_planners = BTreeSet::new();
+    for root in &census.roots {
+        if !root.reachable
+            || root.failure.is_some()
+            || root.planner_ids.is_empty()
+            || root.plan_file_count as usize != root.planner_ids.len()
+            || !is_sha256(&root.inventory_digest)
+            || root.planner_ids.windows(2).any(|pair| pair[0] >= pair[1])
+        {
+            return Err(AnalysisUnknownReason::IncompleteCoverage);
+        }
+        for planner_id in &root.planner_ids {
+            if !rooted_planners.insert(planner_id.as_str()) {
+                return Err(AnalysisUnknownReason::IncompleteCoverage);
+            }
+        }
+    }
+    if rooted_planners != registration_ids {
+        return Err(AnalysisUnknownReason::IncompleteCoverage);
+    }
+
+    for planner in &census.planners {
+        let registration = document
+            .registrations
+            .iter()
+            .find(|entry| entry.identity.planner_id == planner.planner_id)
+            .ok_or(AnalysisUnknownReason::IncompleteCoverage)?;
+        if planner.repository_id != registration.identity.repository_id
+            || planner.branch != registration.identity.branch
+            || planner.plan_id != registration.identity.plan_id
+            || planner.files != registration.identity.files
+            || planner.resources != registration.identity.resources
+            || planner.nodes != registration.identity.nodes
+            || planner.lease_generation != registration.lease_generation
+            || planner.registered_at_ms != registration.registered_at_ms
+            || planner.updated_at_ms != registration.updated_at_ms
+            || planner.heartbeat_at_ms != registration.heartbeat_at_ms
+            || planner.lease_expires_at_ms != registration.lease_expires_at_ms
+            || planner.lease_expires_at_ms <= now_ms
+            || !is_sha256(&planner.repository_identity)
+            || !is_sha256(&planner.worktree_identity)
+            || !is_sha256(&planner.plan_content_digest)
+            || !is_sha256(&planner.manifest_digest)
+            || planner_manifest_digest(planner) != planner.manifest_digest
+        {
+            return Err(AnalysisUnknownReason::InvalidManifest);
+        }
+    }
+    Ok(())
+}
+
+fn sorted_unique<'a>(
+    values: impl Iterator<Item = &'a str>,
+) -> Result<BTreeSet<&'a str>, AnalysisUnknownReason> {
+    let mut output = BTreeSet::new();
+    for value in values {
+        if value.is_empty() || !output.insert(value) {
+            return Err(AnalysisUnknownReason::IncompleteCoverage);
+        }
+    }
+    Ok(output)
+}
+
+fn collect_claims<'a>(
+    census: &'a DiscoveryCensus,
+    now_ms: u64,
+) -> Result<(Vec<ClaimRef<'a>>, DispositionIndex<'a>), AnalysisUnknownReason> {
+    let mut contracts = BTreeMap::new();
+    let mut dispositions = DispositionIndex::new();
+    let mut claims = Vec::new();
+    let mut claim_ids = BTreeSet::new();
+
+    // Validation is deliberately phased. A malformed snapshot always wins over a malformed
+    // contract, independent of census order, so equivalent invalid inputs have one stable result.
+    for planner in &census.planners {
+        let snapshot = &planner.claim_snapshot;
+        if snapshot.status != ClaimSnapshotStatus::Complete
+            || snapshot.failure.is_some()
+            || snapshot.repository_identity != planner.repository_identity
+            || snapshot.source_manifest_digest != planner.plan_content_digest
+            || super::registry::validate_canonical_claim_snapshot(snapshot).is_err()
+        {
+            return Err(AnalysisUnknownReason::InvalidClaimSnapshot);
+        }
+    }
+
+    let participant_count = census.planners.iter().try_fold(0usize, |total, planner| {
+        total.checked_add(planner.claim_snapshot.contracts.len())
+    });
+    let claim_count = census.planners.iter().try_fold(0usize, |total, planner| {
+        total.checked_add(planner.claim_snapshot.claims.len())
+    });
+    if participant_count.is_none_or(|count| count > MAX_ANALYZER_PARTICIPANTS)
+        || claim_count.is_none_or(|count| count > MAX_ANALYZER_CLAIMS)
+    {
+        return Err(AnalysisUnknownReason::LimitExceeded);
+    }
+
+    for planner in &census.planners {
+        let snapshot = &planner.claim_snapshot;
+        for contract in &snapshot.contracts {
+            if contract.observed_at_ms > now_ms
+                || contract.expires_at_ms <= now_ms
+                || contract.lease_generation != planner.lease_generation
+                || contract.observed_at_ms != planner.heartbeat_at_ms
+                || contract.expires_at_ms != planner.lease_expires_at_ms
+                || contracts
+                    .insert(contract.participant_id.as_str(), contract)
+                    .is_some()
+            {
+                return Err(AnalysisUnknownReason::InvalidActiveContract);
+            }
+            for rule in &contract.disposition_rules {
+                if dispositions
+                    .insert(
+                        (contract.participant_id.as_str(), rule.claim_id.as_str()),
+                        rule.disposition,
+                    )
+                    .is_some()
+                {
+                    return Err(AnalysisUnknownReason::InvalidActiveContract);
+                }
+            }
+        }
+    }
+
+    for planner in &census.planners {
+        for claim in &planner.claim_snapshot.claims {
+            let contract = contracts
+                .get(claim.participant_id.as_str())
+                .copied()
+                .ok_or(AnalysisUnknownReason::InvalidActiveContract)?;
+            if matches!(
+                contract.state,
+                ActiveClaimState::Completed | ActiveClaimState::Released
+            ) || !claim_ids.insert(claim.claim_id.as_str())
+            {
+                return Err(AnalysisUnknownReason::InvalidActiveContract);
+            }
+            claims.push(ClaimRef { claim });
+        }
+    }
+
+    let owned_claims = claims
+        .iter()
+        .map(|item| {
+            (
+                item.claim.participant_id.as_str(),
+                item.claim.claim_id.as_str(),
+            )
+        })
+        .collect::<BTreeSet<_>>();
+    if dispositions.keys().any(|key| !owned_claims.contains(key)) {
+        return Err(AnalysisUnknownReason::InvalidActiveContract);
+    }
+
+    let participant_ids = contracts.keys().copied().collect::<BTreeSet<_>>();
+    for contract in contracts.values() {
+        if contract.dependencies.iter().any(|dependency| {
+            !participant_ids.contains(dependency.as_str()) || dependency == &contract.participant_id
+        }) {
+            return Err(AnalysisUnknownReason::InvalidActiveContract);
+        }
+    }
+    if dependency_graph_has_cycle(&contracts, MAX_DEPENDENCY_EDGES)? {
+        return Err(AnalysisUnknownReason::InvalidActiveContract);
+    }
+    Ok((claims, dispositions))
+}
+
+fn dependency_graph_has_cycle(
+    contracts: &BTreeMap<&str, &ActiveClaimContract>,
+    edge_limit: usize,
+) -> Result<bool, AnalysisUnknownReason> {
+    let mut indegree = contracts
+        .keys()
+        .map(|participant| (*participant, 0usize))
+        .collect::<BTreeMap<_, _>>();
+    let mut dependents = BTreeMap::<&str, Vec<&str>>::new();
+    let mut edge_count = 0usize;
+
+    for (participant, contract) in contracts {
+        if contract
+            .dependencies
+            .windows(2)
+            .any(|pair| pair[0] >= pair[1])
+        {
+            return Err(AnalysisUnknownReason::InvalidActiveContract);
+        }
+        for dependency in &contract.dependencies {
+            edge_count = edge_count
+                .checked_add(1)
+                .ok_or(AnalysisUnknownReason::LimitExceeded)?;
+            if edge_count > edge_limit {
+                return Err(AnalysisUnknownReason::LimitExceeded);
+            }
+            let Some(value) = indegree.get_mut(participant) else {
+                return Err(AnalysisUnknownReason::InvalidActiveContract);
+            };
+            *value = value
+                .checked_add(1)
+                .ok_or(AnalysisUnknownReason::LimitExceeded)?;
+            dependents
+                .entry(dependency.as_str())
+                .or_default()
+                .push(*participant);
+        }
+    }
+
+    let mut ready = indegree
+        .iter()
+        .filter_map(|(participant, count)| (*count == 0).then_some(*participant))
+        .collect::<BTreeSet<_>>();
+    let mut visited = 0usize;
+    while let Some(participant) = ready.pop_first() {
+        visited += 1;
+        if let Some(children) = dependents.get(participant) {
+            for child in children {
+                let Some(count) = indegree.get_mut(child) else {
+                    return Err(AnalysisUnknownReason::InvalidActiveContract);
+                };
+                *count = count
+                    .checked_sub(1)
+                    .ok_or(AnalysisUnknownReason::InvalidActiveContract)?;
+                if *count == 0 {
+                    ready.insert(child);
+                }
+            }
+        }
+    }
+    Ok(visited != contracts.len())
+}
+
+fn intersect_claims(
+    claims: &[ClaimRef<'_>],
+) -> Result<BTreeMap<(String, String), PendingConflict>, AnalysisUnknownReason> {
+    let mut logical = BTreeMap::<&str, Vec<usize>>::new();
+    let mut aliases = BTreeMap::<&str, Vec<usize>>::new();
+    let mut resources = BTreeMap::<&str, Vec<usize>>::new();
+    let mut budget = WorkBudget::default();
+
+    for (index, item) in claims.iter().enumerate() {
+        match item.claim.kind {
+            CanonicalClaimKind::ExactFile => {
+                logical
+                    .entry(item.claim.canonical_key.as_str())
+                    .or_default()
+                    .push(index);
+                if let Some(alias) = item.claim.physical_alias_key.as_deref() {
+                    aliases.entry(alias).or_default().push(index);
+                }
+            }
+            CanonicalClaimKind::DirectoryTree => {
+                logical
+                    .entry(item.claim.canonical_key.as_str())
+                    .or_default()
+                    .push(index);
+            }
+            CanonicalClaimKind::Resource => {
+                resources
+                    .entry(item.claim.canonical_key.as_str())
+                    .or_default()
+                    .push(index);
+            }
+        }
+    }
+
+    let mut conflicts = BTreeMap::new();
+    for bucket in logical.values() {
+        add_bucket_pairs(
+            claims,
+            bucket,
+            |left, right| {
+                if left.kind == CanonicalClaimKind::ExactFile
+                    && right.kind == CanonicalClaimKind::ExactFile
+                {
+                    CollisionBasis::ExactFile
+                } else {
+                    CollisionBasis::DirectoryPrefix
+                }
+            },
+            &mut budget,
+            &mut conflicts,
+        )?;
+    }
+    for bucket in aliases.values() {
+        add_bucket_pairs(
+            claims,
+            bucket,
+            |_, _| CollisionBasis::PhysicalAlias,
+            &mut budget,
+            &mut conflicts,
+        )?;
+    }
+    for bucket in resources.values() {
+        add_bucket_pairs(
+            claims,
+            bucket,
+            |_, _| CollisionBasis::Resource,
+            &mut budget,
+            &mut conflicts,
+        )?;
+    }
+    for (child_index, child) in claims.iter().enumerate() {
+        if child.claim.kind == CanonicalClaimKind::Resource {
+            continue;
+        }
+        for ancestor in &child.claim.ancestor_keys {
+            budget.ancestor_probe()?;
+            // Any declared path kind at a parent key conflicts with a descendant path. An
+            // ExactFile parent is impossible as a real directory, but it can arise for missing
+            // planned paths; treating it as free would let two workers race on the type itself.
+            if let Some(owners) = logical.get(ancestor.as_str()) {
+                for owner_index in owners {
+                    add_pair(
+                        claims,
+                        *owner_index,
+                        child_index,
+                        CollisionBasis::DirectoryPrefix,
+                        &mut budget,
+                        &mut conflicts,
+                    )?;
+                }
+            }
+        }
+    }
+    Ok(conflicts)
+}
+
+fn add_bucket_pairs(
+    claims: &[ClaimRef<'_>],
+    bucket: &[usize],
+    basis: impl Fn(&CanonicalClaim, &CanonicalClaim) -> CollisionBasis,
+    budget: &mut WorkBudget,
+    conflicts: &mut BTreeMap<(String, String), PendingConflict>,
+) -> Result<(), AnalysisUnknownReason> {
+    let pair_count = bucket
+        .len()
+        .checked_mul(bucket.len().saturating_sub(1))
+        .and_then(|value| value.checked_div(2))
+        .ok_or(AnalysisUnknownReason::LimitExceeded)?;
+    if budget
+        .pair_probes
+        .checked_add(pair_count)
+        .is_none_or(|total| total > MAX_PAIR_PROBES)
+    {
+        return Err(AnalysisUnknownReason::LimitExceeded);
+    }
+    for (offset, left) in bucket.iter().enumerate() {
+        for right in &bucket[offset + 1..] {
+            add_pair(
+                claims,
+                *left,
+                *right,
+                basis(claims[*left].claim, claims[*right].claim),
+                budget,
+                conflicts,
+            )?;
+        }
+    }
+    Ok(())
+}
+
+fn add_pair(
+    claims: &[ClaimRef<'_>],
+    left: usize,
+    right: usize,
+    basis: CollisionBasis,
+    budget: &mut WorkBudget,
+    conflicts: &mut BTreeMap<(String, String), PendingConflict>,
+) -> Result<(), AnalysisUnknownReason> {
+    budget.pair_probe()?;
+    if left == right || claims[left].claim.participant_id == claims[right].claim.participant_id {
+        return Ok(());
+    }
+    let (left, right) = if claims[left].claim.claim_id <= claims[right].claim.claim_id {
+        (left, right)
+    } else {
+        (right, left)
+    };
+    let key = (
+        claims[left].claim.claim_id.clone(),
+        claims[right].claim.claim_id.clone(),
+    );
+    conflicts
+        .entry(key)
+        .and_modify(|conflict| {
+            conflict.bases.insert(basis);
+        })
+        .or_insert_with(|| PendingConflict {
+            left,
+            right,
+            bases: BTreeSet::from([basis]),
+        });
+    if conflicts.len() > MAX_CONFLICTS {
+        return Err(AnalysisUnknownReason::LimitExceeded);
+    }
+    Ok(())
+}
+
+fn authorize_conflicts(
+    claims: &[ClaimRef<'_>],
+    dispositions: &DispositionIndex<'_>,
+    pending: BTreeMap<(String, String), PendingConflict>,
+) -> (Vec<CollisionConflict>, Option<AnalysisUnknownReason>) {
+    let mut output = Vec::with_capacity(pending.len());
+    let mut failure = None;
+    for pending in pending.into_values() {
+        let left = claims[pending.left];
+        let right = claims[pending.right];
+        let left_disposition = disposition_for(dispositions, left);
+        let right_disposition = disposition_for(dispositions, right);
+        let disposition = match (left_disposition, right_disposition) {
+            (Ok(left), Ok(right)) if left == right => Some(left),
+            (Ok(_), Ok(_)) => {
+                failure.get_or_insert(AnalysisUnknownReason::ContradictoryDisposition);
+                None
+            }
+            (Err(reason), _) | (_, Err(reason)) => {
+                failure.get_or_insert(reason);
+                None
+            }
+        };
+        let bases = pending.bases.into_iter().collect::<Vec<_>>();
+        output.push(CollisionConflict {
+            conflict_id: conflict_id(left.claim, right.claim, &bases),
+            left_participant_id: left.claim.participant_id.clone(),
+            right_participant_id: right.claim.participant_id.clone(),
+            left_claim_id: left.claim.claim_id.clone(),
+            right_claim_id: right.claim.claim_id.clone(),
+            bases,
+            disposition,
+        });
+    }
+    output.sort_by(|left, right| left.conflict_id.cmp(&right.conflict_id));
+    (output, failure)
+}
+
+fn disposition_for(
+    dispositions: &DispositionIndex<'_>,
+    claim: ClaimRef<'_>,
+) -> Result<ConflictDisposition, AnalysisUnknownReason> {
+    dispositions
+        .get(&(
+            claim.claim.participant_id.as_str(),
+            claim.claim.claim_id.as_str(),
+        ))
+        .copied()
+        .ok_or(AnalysisUnknownReason::MissingDisposition)
+}
+
+fn aggregate_verdict(
+    conflicts: &[CollisionConflict],
+) -> Result<CollisionVerdict, AnalysisUnknownReason> {
+    let Some(first) = conflicts.first() else {
+        return Ok(CollisionVerdict::Clear);
+    };
+    let first = first
+        .disposition
+        .ok_or(AnalysisUnknownReason::MissingDisposition)?;
+    if conflicts
+        .iter()
+        .any(|conflict| conflict.disposition != Some(first))
+    {
+        return Err(AnalysisUnknownReason::MixedDispositions);
+    }
+    Ok(match first {
+        ConflictDisposition::Wait => CollisionVerdict::Wait,
+        ConflictDisposition::Replan => CollisionVerdict::Replan,
+        ConflictDisposition::UserDecision => CollisionVerdict::UserDecision,
+    })
+}
+
+fn conflict_id(left: &CanonicalClaim, right: &CanonicalClaim, bases: &[CollisionBasis]) -> String {
+    let (left, right) = if left.claim_id <= right.claim_id {
+        (left, right)
+    } else {
+        (right, left)
+    };
+    let mut encoder = DigestEncoder::new(b"perfect-planner:collision-conflict-id:v1");
+    encoder.text(&left.participant_id);
+    encoder.text(&right.participant_id);
+    encoder.text(&left.claim_id);
+    encoder.text(&right.claim_id);
+    encoder.u64(bases.len() as u64);
+    for basis in bases {
+        encoder.text(match basis {
+            CollisionBasis::ExactFile => "EXACT_FILE",
+            CollisionBasis::PhysicalAlias => "PHYSICAL_ALIAS",
+            CollisionBasis::DirectoryPrefix => "DIRECTORY_PREFIX",
+            CollisionBasis::Resource => "RESOURCE",
+        });
+    }
+    encoder.hex()
+}
+
+fn is_sha256(value: &str) -> bool {
+    value.len() == 64
+        && value
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || matches!(byte, b'a'..=b'f'))
+}
+
+struct DigestEncoder(Sha256);
+
+impl DigestEncoder {
+    fn new(domain: &[u8]) -> Self {
+        let mut encoder = Self(Sha256::new());
+        encoder.bytes(domain);
+        encoder
+    }
+
+    fn u64(&mut self, value: u64) {
+        self.0.update(value.to_le_bytes());
+    }
+
+    fn bytes(&mut self, value: &[u8]) {
+        self.u64(value.len() as u64);
+        self.0.update(value);
+    }
+
+    fn text(&mut self, value: &str) {
+        self.bytes(value.as_bytes());
+    }
+
+    fn hex(self) -> String {
+        const HEX: &[u8; 16] = b"0123456789abcdef";
+        let mut output = String::with_capacity(64);
+        for byte in self.0.finalize() {
+            output.push(HEX[(byte >> 4) as usize] as char);
+            output.push(HEX[(byte & 0x0f) as usize] as char);
+        }
+        output
+    }
+}
