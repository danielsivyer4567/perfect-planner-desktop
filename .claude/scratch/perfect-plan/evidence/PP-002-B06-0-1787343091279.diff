+    fn graph_contract(
+        participant_id: String,
+        mut dependencies: Vec<String>,
+    ) -> ActiveClaimContract {
+        dependencies.sort();
+        ActiveClaimContract {
+            run_identity: opaque(&format!("graph-run:{participant_id}")),
+            worker_identity: opaque(&format!("graph-worker:{participant_id}")),
+            participant_id,
+            fence: 1,
+            lease_generation: 1,
+            state: ActiveClaimState::Planned,
+            dependencies,
+            assumption_digest: opaque("graph-assumption"),
+            policy_digest: opaque("graph-policy"),
+            active_state_digest: opaque("graph-state"),
+            disposition_rules: Vec::new(),
+            observed_at_ms: OBSERVED_MS,
+            expires_at_ms: EXPIRES_MS,
+        }
+    }
