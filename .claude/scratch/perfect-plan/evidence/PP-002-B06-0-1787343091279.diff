+        path_claims[1].claim_id = test_claim_id(&path_claims[1]);
+        let refs = path_claims
+            .iter()
+            .map(|claim| ClaimRef { claim })
+            .collect::<Vec<_>>();
+        assert!(intersect_claims(&refs).unwrap().is_empty());
+    }
+
+    #[test]
+    fn analyzer_module_has_no_io_authority_in_its_production_surface() {
+        let production = include_str!("analyzer.rs")
+            .split("#[cfg(test)]")
+            .next()
+            .unwrap();
+        for forbidden in [
+            "std::fs",
+            "std::io",
+            "std::path",
+            "std::process",
+            "std::net",
+            "std::time",
+            "std::env",
+            "std::thread",
+            "SystemTime",
+            "Instant",
+            "tauri::command",
+            "repository_root",
+            "worktree_root",
+        ] {
+            assert!(
+                !production.contains(forbidden),
+                "forbidden authority: {forbidden}"
+            );
+        }
+    }
+
+    #[test]
+    fn complete_registry_analysis_input_is_sealed_in_production() {
+        let registry_source = include_str!("registry.rs");
+        assert!(
+            registry_source.contains("pub(crate) struct CompleteRegistryRead(RegistryDocument);")
+        );
+        assert!(registry_source.contains("Complete(CompleteRegistryRead)"));
+        assert!(registry_source.contains("fn complete(document: RegistryDocument) -> Self"));
+        assert!(registry_source.contains("#[cfg(test)]\nimpl std::ops::DerefMut"));
+
+        let analyzer_production = include_str!("analyzer.rs")
+            .split("#[cfg(test)]")
+            .next()
+            .unwrap();
+        assert!(!analyzer_production.contains("RegistryRead::complete_for_test"));
+        assert!(!analyzer_production.contains("RegistryRead::Complete(RegistryDocument"));
+    }
+
+    #[test]
+    fn terminal_tombstones_never_own_a_claim() {
+        let mut read = complete_read(vec![planner(
+            "a",
+            vec![spec(
+                CanonicalClaimKind::Resource,
+                "resource:a",
+                &[],
+                None,
+                ConflictDisposition::Wait,
+            )],
+        )]);
+        let RegistryRead::Complete(document) = &mut read else {
+            unreachable!()
+        };
+        let snapshot = &mut document.census.as_mut().unwrap().planners[0].claim_snapshot;
+        snapshot.contracts[0].state = ActiveClaimState::Completed;
+        snapshot.contracts[0].disposition_rules.clear();
+        snapshot.digest = snapshot_digest(snapshot);
+        let planner = &mut document.census.as_mut().unwrap().planners[0];
+        planner.manifest_digest = planner_manifest_digest(planner);
+        assert_eq!(
+            analyze_registry_read(&read, NOW_MS).verdict,
+            CollisionVerdict::Unknown
+        );
+    }
+}
