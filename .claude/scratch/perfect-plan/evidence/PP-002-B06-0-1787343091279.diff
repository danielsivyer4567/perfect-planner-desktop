+                    canonical_key: spec.key,
+                    ancestor_keys: spec.ancestors,
+                    physical_alias_key: spec.alias,
+                };
+                claim.ancestor_keys.sort();
+                claim.ancestor_keys.dedup();
+                claim.claim_id = test_claim_id(&claim);
+                (claim, spec.disposition)
+            })
+            .collect::<Vec<_>>();
+        claims_and_dispositions.sort_by(|left, right| left.0.cmp(&right.0));
+        let claims = claims_and_dispositions
+            .iter()
